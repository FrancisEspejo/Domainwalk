# Copia a .domainwalk.toml en la raíz del proyecto (o a ~/.config/domainwalk/config.toml).

timeout = 8.0

# Los hallazgos silenciados bajan a INFO y no cuentan para el grade.
# La razón sale en el informe, así que dentro de seis meses sabrás por qué está ahí.
# Se admite comodín: "hdr.*" silencia todas las cabeceras.
[mute]
"hdr.hsts" = "GitHub Pages no permite cabeceras propias"
"hdr.csp" = "GitHub Pages no permite cabeceras propias"
"hdr.xcto" = "GitHub Pages no permite cabeceras propias"
"hdr.frame" = "GitHub Pages no permite cabeceras propias"
"hdr.referrer" = "GitHub Pages no permite cabeceras propias"
