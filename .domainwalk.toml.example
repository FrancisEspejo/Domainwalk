# Copy to .domainwalk.toml in your working directory, or to
# ~/.config/domainwalk/config.toml.

timeout = 8.0

# Muted findings drop to INFO and stop counting toward the grade. The reason is
# printed with the finding, so six months from now you know why it is quiet.
# Patterns work, so "hdr.*" covers every header check.
[mute]
"hdr.*" = "GitHub Pages does not allow custom response headers"
